{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:space-sim:code-module:1",
  "title": "Local code module descriptor or artifact; runtime validates sizes, digests and cross-field compatibility",
  "oneOf": [
    {
      "$ref": "#/$defs/build"
    },
    {
      "$ref": "#/$defs/artifact"
    }
  ],
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "apiVersion",
        "id",
        "name",
        "version",
        "kind",
        "authority",
        "environments",
        "dependencies",
        "provides",
        "requires",
        "slots",
        "before",
        "after",
        "settings",
        "license"
      ],
      "properties": {
        "format": {
          "const": "space-sim-module/1"
        },
        "apiVersion": {
          "const": "space-sim-game-api/1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "const": "provider"
        },
        "authority": {
          "enum": [
            "authoritative",
            "presentation"
          ]
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "browser",
              "offline",
              "node"
            ]
          }
        },
        "dependencies": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
                "maxLength": 256
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
                "maxLength": 256
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "provides": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "requires": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "slots": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "before": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "after": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "default",
              "minimum",
              "maximum"
            ],
            "properties": {
              "type": {
                "const": "number"
              },
              "default": {
                "type": "number"
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "\\S"
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "maxLength": 64 },
              "label": { "type": "string", "minLength": 1, "maxLength": 32 },
              "key": { "type": "string" },
              "context": { "enum": ["flight", "eva", "editor", "all"] },
              "description": { "type": "string", "maxLength": 256 }
            }
          }
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "entry",
        "compatibility",
        "attribution"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/manifest"
        },
        "entry": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deterministic",
            "multiplayer"
          ],
          "properties": {
            "deterministic": {
              "type": "boolean"
            },
            "multiplayer": {
              "type": "boolean"
            }
          },
          "if": {
            "properties": {
              "multiplayer": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "deterministic": {
                "const": true
              }
            }
          }
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "assets": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
          }
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "license",
              "attribution"
            ],
            "properties": {
              "license": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "attribution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "manifest",
        "source",
        "assets",
        "inputs",
        "compatibility",
        "digest"
      ],
      "properties": {
        "format": {
          "const": "space-sim-code-module/1"
        },
        "manifest": {
          "$ref": "#/$defs/manifest"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "assets": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "license",
              "attribution"
            ],
            "properties": {
              "license": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "attribution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "path": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deterministic",
            "multiplayer"
          ],
          "properties": {
            "deterministic": {
              "type": "boolean"
            },
            "multiplayer": {
              "type": "boolean"
            }
          },
          "if": {
            "properties": {
              "multiplayer": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "deterministic": {
                "const": true
              }
            }
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
