  "manifest": {
    "format": "space-sim-module/2",
    "apiVersion": "space-sim-game-api/2",
    "id": "spacelab.theme",
    "name": "Theme and procedural backdrop",
    "version": "0.1.0",
    "kind": "provider",
    "environments": [
      "browser",
      "offline"
    ],
    "dependencies": [],
    "conflicts": [],
    "provides": [
      {
        "name": "presentation.themes",
        "version": "1.0.0"
      }
    ],
    "requires": [],
    "slots": [
      "presentation.themes"
    ],
    "before": [],
    "after": [],
    "settings": {
      "windowOpacity": {
        "type": "number",
        "default": 0.96,
        "minimum": 0.4,
        "maximum": 1,
        "step": 0.01,
        "label": "Default window opacity",
        "description": "Opacity for viewers without a saved window preference. Saved viewer choices take precedence. Applies to presentation only."
      },
      "starDensity": {
        "type": "number",
        "default": 1,
        "minimum": 0.5,
        "maximum": 2,
        "step": 0.05,
        "label": "Default star density",
        "description": "Background star-density multiplier for viewers without a saved choice. These decorative stars have no physical bodies or collision."
      },
      "nebulaIntensity": {
        "type": "number",
        "default": 1,
        "minimum": 0,
        "maximum": 2,
        "step": 0.05,
        "label": "Default nebula intensity",
        "description": "Brightness of the procedural nebula background before viewer preferences override it. Does not affect lighting physics."
      },
      "gridOpacity": {
        "type": "number",
        "default": 0.45,
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "label": "Default grid opacity",
        "description": "Opacity of the optional background grid before viewer preferences override it. This does not turn the grid on."
      },
      "gridSpacing": {
        "type": "number",
        "default": 80,
        "minimum": 8,
        "maximum": 512,
        "step": 1,
        "label": "Default grid spacing (px)",
        "description": "Screen-space grid spacing in CSS pixels before viewer preferences override it. Does not change world coordinates or scale."
      }
    },
    "license": "MIT",
    "tier": "presentation"
  },
  "entry": "src/index.ts",
  "build": {
    "bundle": "dist/module.js",
    "toolchain": "rolldown/1.2.14;typescript/7.0.2;api/2",
