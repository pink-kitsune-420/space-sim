{
  "format": "space-lab-game/1",
  "info": {
    "id": "builtin.flight-starter",
    "name": "Flight starter",
    "description": "A minimal flight demo with a simple 2D view and navball. Hold Space to lift off, release it to coast, and use Left/Right to turn. A starting point for creating your own flight game."
  },
  "bundle": {
    "format": "space-sim-module-profile/1",
    "profile": {
      "format": "space-sim-profile/1",
      "id": "builtin.default",
      "modules": [
        { "id": "builtin.content", "version": "0.1.0" },
        { "id": "builtin.motion", "version": "0.1.0" }
      ],
      "providers": { "content": "builtin.content", "motion": "builtin.motion" },
      "settings": {}
    },
    "modules": [],
    "presentation": {
      "format": "space-sim-profile/1",
      "id": "builtin.flight-starter-presentation",
      "modules": [
        { "id": "builtin.canvas", "version": "0.1.0" },
        { "id": "builtin.navball", "version": "0.1.0" },
        { "id": "builtin.throttle", "version": "0.1.0" }
      ],
      "providers": { "renderer": "builtin.canvas" },
      "settings": { "builtin.navball": { "frame": 1, "orientation": 1 } }
    },
    "selection": { "universe": "builtin.content/default-universe" }
  },
  "plugins": []
}
