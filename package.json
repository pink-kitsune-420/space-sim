{
  "name": "space-lab",
  "version": "0.6.1-alpha",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:sandbox": "vite apps/orbit-sandbox --port 5174",
    "build": "node scripts/sync_versions.mjs --check && tsc --noEmit && vite build && node scripts/build_offline.mjs && vite build --config vite.server.config.ts && vite build --config vite.desktop.config.ts",
    "version": "node scripts/sync_versions.mjs",
    "build:server-exe": "node scripts/build_server_exe.mjs",
    "build:game-exe": "node scripts/build_game_exe.mjs",
    "package": "node scripts/package.mjs",
    "desktop": "node dist-desktop/space-sim-desktop.cjs",
    "server": "node dist-server/space-sim-server.cjs",
    "host": "npm run build && node dist-server/space-sim-server.cjs --open",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:sandbox": "vitest run --config apps/orbit-sandbox/vitest.config.ts",
    "measure": "node scripts/measure_browser.mjs",
    "measure:modules": "node scripts/measure_module_baseline.mjs",
    "measure:orbits": "node --experimental-strip-types scripts/measure_orbits.mjs",
    "measure:tables": "node scripts/benchmark_orbit_tables.mjs",
    "measure:surfaces": "node --expose-gc --experimental-strip-types scripts/measure_surfaces.mjs",
    "check:licenses": "node scripts/check_licenses.mjs",
    "check": "npm run check:modules && npm run build && npm test && node scripts/check_licenses.mjs && python3 scripts/verify_project.py",
    "check:modules": "node packages/module-tools/check-boundaries.mjs",
    "module:build": "node packages/module-tools/package.mjs build",
    "module:validate": "node packages/module-tools/package.mjs validate",
    "measure:code-modules": "node scripts/measure_code_modules.mjs",
    "module:new": "node packages/module-tools/package.mjs new",
    "module:fork": "node packages/module-tools/package.mjs fork",
    "module:convert": "node packages/module-tools/package.mjs convert",
    "module:pack": "node packages/module-tools/package.mjs pack",
    "module:unpack": "node packages/module-tools/package.mjs unpack",
    "game:build": "node packages/module-tools/package.mjs game-build",
    "game:validate": "node packages/module-tools/package.mjs game-validate",
    "file:pack": "node packages/module-tools/package.mjs pack",
    "file:unpack": "node packages/module-tools/package.mjs unpack",
    "file:validate": "node packages/module-tools/package.mjs validate"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "postject": "1.0.0-alpha.6",
    "rolldown": "1.2.14",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
